# ---------------------------------------------------------------------------
# Google Service Account (WAJIB)
# 1. Buka https://console.cloud.google.com/ → buat project (atau pakai yang ada)
# 2. APIs & Services → Credentials → Create Credentials → Service Account
# 3. Download JSON, lalu tempel field "client_email" & "private_key" ke bawah
# 4. Aktifkan API: Google Sheets API + Google Drive API
# 5. Share spreadsheet & folder Drive ke email service account (akses Editor)
# ---------------------------------------------------------------------------

GOOGLE_SERVICE_ACCOUNT_EMAIL=erapor-api@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----\n"

# ID spreadsheet (bagian URL antara /d/ dan /edit)
GOOGLE_SPREADSHEET_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz

# Folder Drive untuk foto profil, logo, dan background.
GOOGLE_DRIVE_FOLDER_ID=1XyZwVuTsRqPonMlKjIhGfEdCbA

# Folder Drive terpisah untuk foto kegiatan (foto laporan harian).
# Bila dikosongkan, foto kegiatan ikut masuk ke GOOGLE_DRIVE_FOLDER_ID.
GOOGLE_DRIVE_FOLDER_KEGIATAN=1XyZwVuTsRqPonMlKjIhGfEdCbB

# ---------------------------------------------------------------------------
# Session (WAJIB) — generate dengan: openssl rand -base64 48
# ---------------------------------------------------------------------------
SESSION_SECRET=ganti-dengan-random-string-panjang-minimal-32-karakter

# Berapa jam session login bertahan sebelum harus login ulang
SESSION_TTL_HOURS=8

# URL produksi, dipakai untuk tautan absolut di dalam aplikasi
NEXT_PUBLIC_APP_URL=http://localhost:3000
# ---------------------------------------------------------------------------
# Google Drive untuk UNGGAH FOTO (WAJIB bila memakai foto).
#
# Service Account tidak punya kuota penyimpanan Drive, jadi upload memakai izin
# akun Google pemilik folder — satu-satunya cara yang didukung Google.
#
# Cara mengisi: login sebagai admin → Sistem & Akses → klik "Hubungkan Ulang
# Drive" → setujui di layar Google. Tokennya tersimpan OTOMATIS sebagai baris
# rahasia di spreadsheet (sheet Pengaturan, kunci berawalan "_"), sehingga tetap
# berlaku di Vercel tanpa perlu mengubah Environment Variables dan tanpa redeploy.
#
# GOOGLE_OAUTH_REFRESH_TOKEN hanya perlu diisi bila Drive dihubungkan lewat
# terminal (npm run oauth:drive) di komputer, bukan lewat tombol di aplikasi.
# ---------------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=619936964497-xxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_OAUTH_CONNECTED_AT=

# ---------------------------------------------------------------------------
# Vercel: isi NEXT_PUBLIC_APP_URL di atas dengan domain produksi
# (https://<nama-app>.vercel.app) supaya tautan di email mengarah ke sana.
# Daftarkan juga https://<domain>/api/oauth/callback di Google Cloud →
# Clients → Authorized redirect URIs sebelum memakai tombol Hubungkan Ulang.
# ---------------------------------------------------------------------------
